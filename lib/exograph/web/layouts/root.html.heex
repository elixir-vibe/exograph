<!DOCTYPE html>
<html lang="en" class="h-full bg-zinc-950 text-zinc-100">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <title>Exograph</title>
    <link rel="stylesheet" href={Volt.static_path(Exograph.Web.Endpoint, "/assets/css/app.css")} />
    <link rel="stylesheet" href={Volt.static_path(Exograph.Web.Endpoint, "/assets/js/client.css")} />
    <script defer type="module" src={Volt.static_path(Exograph.Web.Endpoint, "/assets/js/client.js")}></script>
  </head>
  <body class="h-full overflow-hidden antialiased bg-zinc-950 text-zinc-100">
    {@inner_content}
  </body>
</html>
